Port 8888
Listen 0.0.0.0
Timeout 600
LogLevel Warning
MaxClients 50

# Allowlist: deny everything except hosts matched by the filter file.
Filter "/etc/tinyproxy/filter"
FilterDefaultDeny Yes
FilterType ere
FilterURLs Off
FilterCaseSensitive Off

# CONNECT (HTTPS tunnels) only to port 443.
ConnectPort 443
